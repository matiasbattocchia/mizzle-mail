EMAIL=you@example.com
# generate at https://myaccount.google.com/apppasswords (needs 2-Step Verification; NOT your login password)
APP_PASSWORD=
# optional overrides (defaults are Gmail)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
PORT=4173

# what happens to an email once it mizzles (decays out of the feed):
#   inbox   = nothing — just hidden from the feed (default, fully safe)
#   archive = remove from Inbox, keep in All Mail (non-destructive, still searchable)
#   trash   = move to Trash (recoverable ~30 days, then gone for good)
MIZZLE_TO=inbox
