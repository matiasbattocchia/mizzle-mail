# ── required ──────────────────────────────────────────────
EMAIL=you@gmail.com
# generate at https://myaccount.google.com/apppasswords (needs 2-Step Verification; NOT your login password)
APP_PASSWORD=

# login gate for the web UI (HTTP basic auth). Username is your EMAIL above.
# Leave blank to run open (fine for localhost). REQUIRED for any deployed / shared URL.
# Use a DISTINCT password — do NOT reuse APP_PASSWORD (that's your Gmail key).
AUTH_PASSWORD=

# what happens to an email once it mizzles (decays out of the feed):
#   inbox   = nothing — just hidden from the feed (default, fully safe)
#   archive = remove from Inbox, keep in All Mail (non-destructive, still searchable)
#   delete  = move to Trash (recoverable ~30 days, then gone for good)
#   mixed   = touched it → archive, untouched noise → delete
#             ("touched" = you liked, shared, or replied to it)
MIZZLE_TO=inbox

# how far back (in days) to seed the feed on first run; older mail is ignored forever
SEED_DAYS=3

# per-category lifetime in days (JSON) — these are the defaults; edit to taste.
# Nothing should outlive the largest value (the "nothing past 7 days" promise).
DECAY_TTLS={"primary":7,"updates":3,"social":1,"forums":1,"promotions":1}

# ── optional (defaults shown) ─────────────────────────────
PORT=4173
IMAP_HOST=imap.gmail.com
IMAP_PORT=993