{
  "name": "mizzle-hosted",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Hosted multi-user Mizzle on Cloudflare Workers + D1, via the Gmail API (OAuth).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute mizzle --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute mizzle --local --file=./schema.sql",
    "secrets": "node scripts/set-secrets.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "wrangler": "^3.90.0"
  }
}
